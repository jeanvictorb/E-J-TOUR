{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/exercicio2/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "dest": "dist/exercicio2/server/server.mjs"
    }
  ]
}